{"html": "\n<style>\n    .weather-container {\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n        padding: 16px;\n        height: 100%;\n        box-sizing: border-box;\n        display: flex;\n        flex-direction: column;\n        gap: 10px;\n        color: #333;\n    }\n    .weather-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n    .weather-city {\n        font-size: 1.1em;\n        font-weight: 600;\n        color: #444;\n    }\n    .weather-time {\n        font-size: 0.85em;\n        color: #999;\n    }\n    .weather-main {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        flex: 1;\n    }\n    .weather-icon {\n        font-size: 3em;\n        line-height: 1;\n    }\n    .weather-temp {\n        font-size: 2.5em;\n        font-weight: 300;\n        line-height: 1;\n    }\n    .weather-temp-unit {\n        font-size: 0.4em;\n        vertical-align: super;\n        color: #999;\n    }\n    .weather-desc {\n        font-size: 1em;\n        color: #666;\n        margin-left: 4px;\n    }\n    .weather-details {\n        display: flex;\n        gap: 16px;\n        font-size: 0.85em;\n        color: #666;\n        flex-wrap: wrap;\n    }\n    .weather-detail-item {\n        display: flex;\n        align-items: center;\n        gap: 4px;\n    }\n    .weather-footer {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n    .weather-range {\n        font-size: 0.85em;\n        color: #888;\n    }\n    .weather-refresh-btn {\n        background: none;\n        border: 1px solid #ddd;\n        border-radius: 6px;\n        padding: 4px 10px;\n        cursor: pointer;\n        font-size: 0.85em;\n        color: #666;\n        transition: all 0.2s;\n    }\n    .weather-refresh-btn:hover {\n        background: #f0f0f0;\n        border-color: #ccc;\n    }\n</style>\n<div class=\"weather-container\">\n    <div class=\"weather-header\">\n        <span class=\"weather-city\">📍 黄山</span>\n        <span class=\"weather-time\">更新于 18:49</span>\n    </div>\n    <div class=\"weather-main\">\n        <span class=\"weather-icon\">⛅</span>\n        <div>\n            <span class=\"weather-temp\">30.9<span class=\"weather-temp-unit\">°C</span></span>\n            <div class=\"weather-desc\">多云</div>\n        </div>\n    </div>\n    <div class=\"weather-details\">\n        <span class=\"weather-detail-item\">💧 湿度 70%</span>\n        <span class=\"weather-detail-item\">💨 风速 5.4 km/h</span>\n    </div>\n    <div class=\"weather-footer\">\n        <span class=\"weather-range\">🌡️ 25.8° / 34.4°</span>\n        <button class=\"weather-refresh-btn\" data-action=\"refresh\">🔄 刷新</button>\n    </div>\n</div>\n", "state": {}, "status": "success"}